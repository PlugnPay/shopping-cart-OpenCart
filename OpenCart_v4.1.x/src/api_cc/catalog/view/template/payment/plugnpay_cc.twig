<fieldset>
  <legend>{{ text_credit_card }}</legend>
  <form id="form-plugnpay-cc" class="mb-3">
    <div class="row mb-3 required">
      <label for="input-cc-owner" class="col-sm-3 col-form-label">{{ entry_cc_owner }}</label>
      <div class="col-sm-9">
        <input type="text" name="cc_owner" value="{{ card_name }}" placeholder="{{ entry_cc_owner }}" id="input-cc-owner" class="form-control" autocomplete="cc-name"/>
      </div>
    </div>
    <div class="row mb-3 required">
      <label for="input-cc-number" class="col-sm-3 col-form-label">{{ entry_cc_number }}</label>
      <div class="col-sm-9">
        <input type="text" name="cc_number" value="" placeholder="{{ entry_cc_number }}" id="input-cc-number" class="form-control" autocomplete="cc-number" inputmode="numeric"/>
      </div>
    </div>
    <div class="row mb-3 required">
      <label for="input-cc-expire-date" class="col-sm-3 col-form-label">{{ entry_cc_expire_date }}</label>
      <div class="col-sm-4">
        <select name="cc_expire_date_month" id="input-cc-expire-date" class="form-select" autocomplete="cc-exp-month">
          {% for month in months %}
            <option value="{{ month.value }}">{{ month.text }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="col-sm-5">
        <select name="cc_expire_date_year" class="form-select" autocomplete="cc-exp-year">
          {% for year in year_expire %}
            <option value="{{ year.value }}">{{ year.text }}</option>
          {% endfor %}
        </select>
      </div>
    </div>
    {% if use_cvv %}
    <div class="row mb-3 required">
      <label for="input-cc-cvv2" class="col-sm-3 col-form-label">{{ entry_cc_cvv2 }}</label>
      <div class="col-sm-9">
        <input type="text" name="cc_cvv2" value="" placeholder="{{ entry_cc_cvv2 }}" id="input-cc-cvv2" class="form-control" autocomplete="cc-csc" inputmode="numeric"/>
      </div>
    </div>
    {% endif %}
  </form>
  <div class="text-end">
    <button type="button" id="button-confirm" class="btn btn-primary">{{ button_confirm }}</button>
  </div>
</fieldset>
<script type="text/javascript"><!--
$('#button-confirm').on('click', function() {
    var element = this;

    $.ajax({
        url: 'index.php?route=extension/plugnpay_api_cc/payment/plugnpay_cc.confirm&language={{ language }}',
        type: 'post',
        data: $('#form-plugnpay-cc :input'),
        dataType: 'json',
        cache: false,
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            if (json['error']) {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['redirect']) {
                location = json['redirect'];
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
